{
  "name": "badgerfang-next",
  "version": "7.0.0",
  "private": true,
  "author": "Purrquinox Digital",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anti-Raid/badgerfang-next"
  },
  "scripts": {
    "build:animalang": "test -f node_modules/animalang/dist/index.es.js || (cd node_modules/animalang && bun install && bun run build)",
    "dev": "next dev",
    "predev": "bun run build:animalang",
    "build": "bun run build:animalang && next build",
    "start": "next start",
    "format": "prettier --write .",
    "testflow": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "rootDir": ".",
            "incremental": false
          }
        }
      ]
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/marked": "^6.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@xyflow/react": "^12.11.0",
    "animalang": "github:Anti-Raid/animalang",
    "axios": "^1.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.17.0",
    "monaco-editor": "^0.55.1",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-toastify": "^11.1.0",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "<=22"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.4.1",
    "eslint-config-next": "16.2.7",
    "jest": "^30.4.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
